    "@napi-rs/canvas": "1.0.11",
    "@react-pdf/renderer": "4.9.0",
    "@scalar/nextjs-api-reference": "0.12.9",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.15",
    "aws4fetch": "1.0.20",
    "better-auth": "1.6.33",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128",
    "date-fns": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
