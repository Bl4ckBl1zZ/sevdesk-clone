{
  "name": "rechnungen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "convex": "convex",
    "auth:schema": "tsx scripts/generate-auth-schema.ts",
    "auth:keys": "tsx scripts/generate-jwks.ts",
    "test": "node scripts/vitest.mjs",
    "test:watch": "vitest",
    "test:coverage": "node scripts/vitest.mjs --coverage",
    "test:backend": "tsx scripts/test-backend.ts",
    "golden": "vitest run --project domain --passWithNoTests test/golden",
    "golden:update": "vitest run --project domain --passWithNoTests test/golden --update",
    "e2e": "playwright test",
    "trace": "tsx scripts/trace.ts",
    "openapi:check": "vitest run --project server src/server/openapi.test.ts",
    "mcp:eval": "tsx scripts/mcp-eval.ts",
    "integrity:verify-checkpoint": "tsx scripts/integrity-verify-checkpoint.ts",
    "lint": "biome check . && tsx scripts/check-boundaries.ts",
    "lint:deploy": "tsx deploy/scripts/check-compose.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p convex",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.6.33",
