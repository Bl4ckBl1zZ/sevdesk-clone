# Environment variables (08-deployment §5, §10). Names only — never commit values.
# Local dev: cp .env.example .env.local and fill in. Production values live in Dokploy / CI secrets.

# ── Convex CLI (local dev / CI; never in the runtime image) ───────────────────────
# Do NOT set CONVEX_DEPLOYMENT together with CONVEX_SELF_HOSTED_* (the CLI refuses mixed configs).
# Without Docker: scripts/convex-local-backend.sh env  → prints both values.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ── Build-time (web image, inlined into the browser bundle) — 08 §5.1 ─────────────
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_SITE_URL=

# ── web (compose environment) — 08 §5.2 ──────────────────────────────────────────
APP_ORIGIN=
API_ORIGIN=
CONVEX_URL_INTERNAL=
CONVEX_SITE_URL_INTERNAL=
JWT_PRIVATE_KEY_PEM=
APP_ENCRYPTION_KEY=
EINVOICE_TOOLS_URL=
LOG_LEVEL=

# ── caddy / backend / postgres / dashboard (compose environment) — 08 §5.2 ───────
# Production values: deploy/env/production.example → .env.production (read by deploy/bootstrap.sh, never committed).
# Local dev with Docker (deploy/compose.dev.yml): EINVOICE_TOOLS_URL=http://127.0.0.1:8080.
IMAGE_REGISTRY=
BASE_DOMAIN=
ACME_EMAIL=
CLOUDFLARE_DNS_API_TOKEN=
CONVEX_DASH_BASIC_AUTH=
INSTANCE_NAME=
INSTANCE_SECRET=
PG_PASSWORD=
CONVEX_SHA=
CADDY_TAG=
WEB_TAG=
EIT_TAG=

# ── Convex function env — set with `pnpm convex env set NAME value`, NOT read from this file ──
# Keys: `pnpm auth:keys dev --set-convex` generates and sets BETTER_AUTH_SECRET, JWKS, SERVER_JWKS,
# CHECKPOINT_SIGNING_KEY_PEM, APP_ENCRYPTION_KEY and prints JWT_PRIVATE_KEY_PEM for `web` (scripts/generate-jwks.ts).
# SITE_URL=                    # https://app.<BASE_DOMAIN> (Better Auth baseURL + trusted origin)
# BETTER_AUTH_SECRET=
# JWKS=                        # static Better Auth JWKS (RS256, private key encrypted with BETTER_AUTH_SECRET)
# PASSKEY_RP_ID=               # = BASE_DOMAIN
# OWNER_EMAIL=                 # bootstrap: the only address that may sign up while no member exists
# BASE_DOMAIN=                 # server-JWT issuer https://api.<BASE_DOMAIN>
# SERVER_JWKS=                 # {"keys":[…]} public ES256 key(s) for server JWTs minted by web (JWT_PRIVATE_KEY_PEM)
# INSTANCE_NAME=               # audit genesis hash + checkpoint payload
# APP_NAME=                    # optional, mail subject / passkey RP name (default "Rechnungen")
# APP_VERSION=                 # optional, written into checkpoints
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
# AUTH_MAIL_FROM=
# AUTH_MAIL_SENDER=            # dev/test: console | memory (08 §10); production: Cloudflare
# R2_ACCOUNT_ENDPOINT=
# R2_CHECKPOINT_BUCKET=
# R2_CHECKPOINT_ACCESS_KEY_ID=
# R2_CHECKPOINT_SECRET_ACCESS_KEY=
# R2_BACKUP_BUCKET=
# R2_BACKUP_READONLY_ACCESS_KEY_ID=
# R2_BACKUP_READONLY_SECRET_ACCESS_KEY=
# R2_INBOX_BUCKET=
# R2_INBOX_ACCESS_KEY_ID=
# R2_INBOX_SECRET_ACCESS_KEY=
# CHECKPOINT_SIGNING_KEY_PEM=  # ES256 PKCS#8; daily signed checkpoint (AUD-016)
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_PRIVATE_KEY_PEM=
# APP_ENCRYPTION_KEY=
# EINVOICE_TOOLS_URL=
# IS_TEST=                     # never in production

# ── Tests ────────────────────────────────────────────────────────────────────────
# Playwright: target an already running app (e.g. https://app.localtest.me via Caddy); unset = Playwright starts next itself.
E2E_BASE_URL=
E2E_PORT=
